# Host port exposed by Docker. The application listens on port 3000 internally.
CASINO_PORT=4399
# Windows: use start-casino-docker.cmd for live Wi-Fi / Ethernet discovery.
# No LAN IP needs to be configured.
# Manual URLs for custom deployments only (disable host discovery first).
PUBLIC_URLS=
# Other Docker hosts can opt into manual URLs by setting HOST_ADDRESSES_FILE=
